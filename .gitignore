# Notebooks run with the repository root as working directory and leave figures, checkpoints
# and datasets there (*.ckpt, ml-1m/, MNIST/, catboost_info/, ...). Ignore everything at the top
# level except the repository's own files.
/*
!/.github/
!/.gitignore
!/internal/
!/notebooks/
!/scripts/
!/tests/
!/LICENSE
!/JUPYTER.md
!/README.md
!/REPRODUCE.md
!/requirements.txt
!/requirements-local.txt

# In JupyterLab, notebooks run in their own folder: keep only the notebooks themselves
/notebooks/**
!/notebooks/**/
!/notebooks/**/*.ipynb
# ...and the standalone reference implementation of fa_em_demo (REPRODUCE.md 4.51)
!/notebooks/book1/20/fa_em.py
# ...and the empty figures/ folders they save into (see JUPYTER.md section 1)
!/notebooks/**/figures/.gitkeep
# the dashboard for JupyterLab (scripts/create_figure_dashboard.py --local, JUPYTER.md section 3)
!/notebooks/book1/dashboard_local.md

__pycache__/
.ipynb_checkpoints/
